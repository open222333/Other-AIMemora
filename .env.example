# ── MEMORA 自架設定（複製為 .env 後修改）──
# 產生隨機值：openssl rand -hex 32
# 注意：POSTGRES_PASSWORD 在資料庫第一次建立後就固定在 volume 裡，之後修改需一併處理資料庫（見 README 疑難排解）

# PostgreSQL 密碼
POSTGRES_PASSWORD=change-me

# Session 簽章密鑰（至少 32 字元；保持範例值時 API 會拒絕啟動）
# 更換後所有人需要重新登入
MEMORA_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# 首次啟動時建立的管理員；密碼留空會隨機產生並印在 api 容器日誌
MEMORA_ADMIN_USERNAME=admin
MEMORA_ADMIN_PASSWORD=

# 經 HTTPS（反向代理 + TLS）提供服務時設為 true，session cookie 只走加密連線
MEMORA_COOKIE_SECURE=false

# Web UI 對外埠（只綁定 127.0.0.1）
WEB_PORT=8080

# ── Embedding（語意搜尋）──
# disabled：不送出任何資料，只使用關鍵字搜尋（預設）
# openai：任何 OpenAI 相容的 /v1/embeddings，例如本機 Ollama：
#   MEMORA_EMBEDDING_PROVIDER=openai
#   MEMORA_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
#   MEMORA_EMBEDDING_MODEL=nomic-embed-text
# 使用外部服務（OpenAI 等）代表記憶內容會傳送給該服務，請自行評估。
MEMORA_EMBEDDING_PROVIDER=disabled
MEMORA_EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
MEMORA_EMBEDDING_MODEL=nomic-embed-text
MEMORA_EMBEDDING_API_KEY=

# API Key 每分鐘請求上限（0 = 不限制）
MEMORA_RATE_LIMIT_PER_MINUTE=120

# 登入節流：同一 IP 或帳號在時間窗內失敗達上限即暫時封鎖
MEMORA_LOGIN_MAX_FAILURES=10
MEMORA_LOGIN_WINDOW_SECONDS=300
